# Token privado da aplicação no Mercado Pago (NUNCA coloque no frontend)
MP_ACCESS_TOKEN=APP_USR-COLOQUE_SEU_ACCESS_TOKEN_AQUI

# Assinatura secreta gerada na configuração de Webhooks do Mercado Pago
MP_WEBHOOK_SECRET=COLOQUE_A_ASSINATURA_SECRETA_AQUI

# URL HTTPS pública do FilaZero, sem barra no final (obrigatória para cartão e Webhook)
PUBLIC_URL=https://seu-dominio.com.br

PORT=3000
